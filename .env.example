# Copy to .env and fill in:   cp .env.example .env
# (.env is read by docker compose, and by mcp_server.py when run locally.)

# Claude API key used by the MCP server (users can still send their own from the page).
ANTHROPIC_API_KEY=sk-ant-...

# Login for the page (HTTP Basic auth). Use a long random password:
#   openssl rand -base64 24
APP_USER=admin
APP_PASSWORD=change-me

# ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=...
# Your free static domain: https://dashboard.ngrok.com/domains
NGROK_URL=https://your-name.ngrok-free.app

# Searches running at the same time (each one = a browser, ~400 MB of RAM).
MAX_CONCURRENT_SEARCHES=2
